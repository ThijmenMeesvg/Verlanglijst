{
  "name": "Verlanglijst beheer",
  "short_name": "Verlanglijst",
  "description": "Zet iets op je verlanglijst door de link vanuit een webwinkel te delen.",
  "id": "./admin.html",
  "start_url": "./admin.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f5f6f1",
  "theme_color": "#1e3b2f",
  "lang": "nl",
  "icons": [
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./admin.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "Bekijk de lijst", "url": "./", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] }
  ]
}
